<Page x:Class="Universal_x86_Tuning_Utility.Views.Pages.Keyboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Universal_x86_Tuning_Utility.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Universal_x86_Tuning_Utility.Views.Controls"
      d:DataContext="{d:DesignInstance local:Keyboard, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="620"
      d:DesignWidth="800"
      Title="Keyboard"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False"
                      Margin="0,0,-18,0">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}"
                       BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,12,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="18,10,18,18">
                <TextBlock FontSize="26" FontWeight="Medium" Text="Keyboard" />
                <TextBlock Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Customize your keyboard backlight color and brightness."
                           TextWrapping="Wrap" />

                <!-- Content when HID keyboard controller is available -->
                <StackPanel x:Name="KeyboardAvailable">
                    <!-- Keyboard power toggle -->
                    <ui:CardControl Margin="0,8,0,0">
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon Grid.Column="0"
                                             FontFamily="Segoe Fluent Icons"
                                             Glyph="&#xE786;"
                                             FontSize="20"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="DemiBold" Text="Keyboard Backlight" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Turn the keyboard backlight on or off." />
                                </StackPanel>

                                <ui:ToggleSwitch x:Name="tsKeyboardPower"
                                                 Grid.Column="2"
                                                 Margin="0,0,9,0"
                                                 IsChecked="True"
                                                 Checked="TsKeyboardPower_Toggled"
                                                 Unchecked="TsKeyboardPower_Toggled" />
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Color picker -->
                    <ui:CardControl Margin="0,8,0,0">
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon Grid.Column="0"
                                             FontFamily="Segoe Fluent Icons"
                                             Glyph="&#xE790;"
                                             FontSize="20"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="DemiBold" Text="Color" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Select a custom color for your keyboard backlight." />
                                </StackPanel>

                                <controls:ColorPickerControl x:Name="ColorPicker"
                                                             Grid.Column="2"
                                                             Margin="0,0,9,0"
                                                             VerticalAlignment="Center"
                                                             SelectedColor="Aqua"
                                                             ColorChangedDelayed="ColorPicker_ColorChangedDelayed" />
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Brightness slider -->
                    <ui:CardControl Margin="0,8,0,0">
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon Grid.Column="0"
                                             FontFamily="Segoe Fluent Icons"
                                             Glyph="&#xE793;"
                                             FontSize="20"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="DemiBold" Text="Brightness" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Adjust the keyboard backlight brightness level." />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="BrightnessValueText"
                                               Width="30"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Text="5" />
                                    <Slider x:Name="BrightnessSlider"
                                            Width="140"
                                            Minimum="0"
                                            Maximum="7"
                                            Value="5"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            ValueChanged="BrightnessSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- White keyboard notice -->
                    <Border x:Name="WhiteKeyboardNotice"
                            Margin="0,8,0,0"
                            Padding="14,12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         FontFamily="Segoe Fluent Icons"
                                         Glyph="&#xE946;"
                                         FontSize="16"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Your keyboard has white backlight only. Color and effect options are not available, but you can still adjust the brightness."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Content when Uniwill EC is NOT available -->
                <StackPanel x:Name="KeyboardUnavailable" Visibility="Collapsed">
                    <Border Margin="0,8,0,0"
                            Padding="14,12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         FontFamily="Segoe Fluent Icons"
                                         Glyph="&#xE7A7;"
                                         FontSize="16"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Keyboard control is not available on this device. This feature requires an ITE HID lighting controller (vid_048d)."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
